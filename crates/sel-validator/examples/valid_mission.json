{
  "id": "rust-hello-world",
  "version": "1.0.0",
  "metadata": {
    "objective": "Build a simple Rust library",
    "author": "claude-4.5",
    "confidence": 0.95
  },
  "execution": {
    "actions": [
      {
        "id": 1,
        "type": "command",
        "command": "cargo init --lib",
        "working_directory": "/workspace/${mission_id}",
        "timeout_seconds": 30,
        "verification": {
          "exit_code": 0,
          "file_must_exist": "Cargo.toml"
        }
      },
      {
        "id": 2,
        "type": "command",
        "command": "cargo build",
        "working_directory": "/workspace/${mission_id}",
        "timeout_seconds": 60,
        "verification": {
          "exit_code": 0,
          "file_must_exist": "target/debug/librust_hello_world.rlib"
        }
      }
    ],
    "completion": {
      "all_actions_must_complete": true,
      "required_artifacts": [
        {
          "path": "target/debug/librust_hello_world.rlib",
          "hash": "sha256:expected_hash_here"
        }
      ]
    }
  }
}
